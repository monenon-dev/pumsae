# Neon — 콘솔에서 복사한 connection string
# 예: postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
COOKIE_SECURE=false

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# 브라우저가 이미지를 불러올 공개 주소 (r2.dev 또는 커스텀 도메인). 끝에 슬래시 없이.
# 예: https://pub-xxxxxxxx.r2.dev  또는  https://images.example.com
R2_PUBLIC_URL=

# 쉼표로 구분. Vercel 배포 후 프론트 URL을 추가하세요.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
